# dtcoach v2 — ÚNICO lugar donde viven los parámetros. Cada uno con su porqué.
proyecto: dtcoach
seed: 20260924

rutas:
  raw_events: data/raw/statsbomb/events        # <match_id>.json.gz del API
  raw_matches: data/raw/statsbomb/matches      # <comp>_<season>.json.gz
  raw_frames: data/raw/statsbomb/frames        # 360 (scripts/descargar/descargar_360.py)
  eventos_parquet: data/interim/events         # salida de `dtcoach aplanar`
  partidos: data/interim/partidos.parquet
  dt_partido: data/interim/dt_por_partido.parquet
  eras_dir: data/referencia/eras_api           # eras VERIFICADAS del proyecto viejo
  exclusiones: data/referencia/eras_api/absorbidos.csv
  transiciones: data/processed/transitions.parquet
  mezcla_dir: data/processed/mezcla
  reportes: reports

pitch: {nx: 5, ny: 4, length: 120.0, width: 80.0}

# ADR-v2-03: la fase de origen SALE del estado. Una sola "fase" => 20 zonas + 4
# absorbentes. El origen (play_pattern) queda en la tabla como covariable de
# los pesos de la mezcla (semana 2), con el mapeo de `origen`.
phase_order: [all]
phases:
  all: [Regular Play, From Counter, From Keeper, From Goal Kick, From Throw In,
        From Kick Off, From Corner, From Free Kick, Other]
phase_default: all

# COPIAR aquí el mapeo `phases` del config viejo si difiere: ese es el que
# está validado. Este es el provisional.
origen:
  open: [Regular Play, Other]
  transition: [From Counter, From Keeper]
  restart: [From Goal Kick, From Throw In, From Kick Off]
  set_piece: [From Corner, From Free Kick]

possession:
  moving_types: [Pass, Carry, Shot]
  pass_loss_outcomes: [Incomplete, Pass Offside, Unknown, Injury Clearance]
  min_actions: 1              # ADR-v2-11: las posesiones de UNA accion son parte del vocabulario
  min_actions_defense: 1      # solo aplica con --club; en liga no se usa
  min_carry_length: 0.0       # COPIAR el valor del config viejo (ADR-13)

context:
  score_bins: [-99, 0, 99]
  score_labels: [losing, drawing, winning]

defense:
  pressure_flag: under_pressure

mezcla:
  k_grid: [1, 2, 3, 4, 5, 6, 7, 8]
  lam: 100.0          # encogimiento de cada P^k hacia la liga; se revisa con CV (semana 1)
  a0: 1.0             # encogimiento de mu^k
  n_init: 10          # solo para init=kmeans (contraste); el default es la escalera
  n_corto: 25         # iteraciones de EM por candidato a partir en la escalera (ADR-v2-17)
  n_init_cv: 2        # arranques dentro de la CV (costo)
  max_iter: 1000
  tol: 1.0e-7
  folds: 5            # POR PARTIDO (ADR-v2-04)
  frac_partidos_cv: 0.5

bondad:
  t_min: 1            # = possession.min_actions (truncamiento C3)
  kmax: 80
